# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private business documents (MOU, MCA filings, brochure, internal playbooks)
/docs/

# test artifacts and debug screenshots
/.playwright-mcp/
/screenshots/
/.agent-shots/
# any image dropped at the repo root — keeps verification screenshots out of git
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif

# next.js build cache that sometimes lands inside /public during dev
/public/.next/

# impeccable live-mode runtime state (helper PID, session token)
.impeccable-live.json
